{
  "expo": {
    "scheme": "ThyrA",
    "name": "ThyrA",
    "slug": "thyra-test-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icons/logo-icon.png",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/icons/logo-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/icons/logo-icon.png",
        "backgroundColor": "#ffffff"
      },
      "permissions": [
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.WRITE_EXTERNAL_STORAGE"
      ],
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "package": "com.thyra.app",
      "statusBarColor": "#ffffff",
      "statusBarStyle": "dark"
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      [
        "expo-media-library",
        {
          "photosPermission": "Allow access to save analysis results to your gallery.",
          "savePhotosPermission": "Allow saving results to your device.",
          "isAccessMediaLocationEnabled": true,
          "granularPermissions": [
            "photo"
          ]
        }
      ]
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "f18e3388-740c-45bf-a9f7-0e34d6848ccd"
      }
    }
  }
}
